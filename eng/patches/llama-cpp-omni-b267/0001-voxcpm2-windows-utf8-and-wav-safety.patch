+static std::vector<std::string> ingest_args(int raw_argc, char ** raw_argv) {
+    std::vector<std::string> arguments;
+#if defined(_WIN32)
+    int wide_argc = 0;
+    LPWSTR * wide_argv = CommandLineToArgvW(GetCommandLineW(), &wide_argc);
+    if (wide_argv == nullptr) {
+        std::fprintf(stderr, "Could not read the UTF-16 Windows command line (error=%lu)\n", GetLastError());
+        return {};
+    }
+
+    arguments.reserve(static_cast<size_t>(wide_argc));
+    for (int index = 0; index < wide_argc; ++index) {
+        const int required = WideCharToMultiByte(
+            CP_UTF8, WC_ERR_INVALID_CHARS, wide_argv[index], -1, nullptr, 0, nullptr, nullptr);
+        if (required <= 0) {
+            std::fprintf(stderr, "Could not convert Windows argument %d to UTF-8 (error=%lu)\n",
+                         index, GetLastError());
+            LocalFree(wide_argv);
+            return {};
+        }
+        std::string utf8(static_cast<size_t>(required), '\0');
+        const int written = WideCharToMultiByte(
+            CP_UTF8, WC_ERR_INVALID_CHARS, wide_argv[index], -1,
+            utf8.data(), required, nullptr, nullptr);
+        if (written != required) {
+            std::fprintf(stderr, "Could not convert Windows argument %d to UTF-8 (error=%lu)\n",
+                         index, GetLastError());
+            LocalFree(wide_argv);
+            return {};
+        }
+        utf8.resize(static_cast<size_t>(required - 1));
+        arguments.push_back(std::move(utf8));
+    }
+    LocalFree(wide_argv);
+    (void) raw_argc;
+    (void) raw_argv;
+#else
+    arguments.reserve(static_cast<size_t>(raw_argc));
+    for (int index = 0; index < raw_argc; ++index) {
+        arguments.emplace_back(raw_argv[index]);
+    }
+#endif
+    return arguments;
+}
+
+static std::filesystem::path utf8_path(const std::string & path) {
+    return std::filesystem::u8path(path);
+}
